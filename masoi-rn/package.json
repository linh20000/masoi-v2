{
  "name": "masoi-rn",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:setup": "expo prebuild --platform ios --clean && open ios/*.xcworkspace",
    "ios:open": "npx expo run:ios",
    "ios:bundle": "npx expo export:embed --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "ios:device": "npx expo run:ios --device"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
